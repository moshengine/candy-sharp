{
  "Root": [
    "_Game",
    "_Game/Art",
    "_Game/Audio",
    "_Game/Config",
    "_Game/Prefabs",
    "_Game/Resources",
    "_Game/Scenes",
    "_Game/Scripts",
    "AddressableAssetsData",
    "Plugins",
    "StreamingAssets",
    "TheraBytes",
    "ThirdParty"
  ],
  "Folders": [
    "_Game",
    "_Game/Art",
    "_Game/Art/Animations",
    "_Game/Art/Fonts",
    "_Game/Art/Materials",
    "_Game/Art/Models",
    "_Game/Art/Shaders",
    "_Game/Art/Sprites",
    "_Game/Art/Textures",
    "_Game/Audio",
    "_Game/Audio/Music",
    "_Game/Audio/SFX",
    "_Game/Config",
    "_Game/Config/URP",
    "_Game/Prefabs",
    "_Game/Resources",
    "_Game/Scenes",
    "_Game/Scripts",
    "_Game/Scripts/Editor",
    "Plugins",
    "StreamingAssets",
    "ThirdParty"
  ],
  "Files": [
    "../.cursorrules",
    "../project.json",
    "../ProjectSettings/ProjectSettings.asset",
    "../README.md",
    "_Game/Art/Sprites/Application/Icon.png",
    "_Game/Scenes/_Main.unity"
  ],
  "Extensions": [
    {
      ".anim": ["_Game/Art/Animations"],
      ".asset": ["_Game/Art/Fonts", "_Game/Config", "_Game/Scenes", "AddressableAssetsData"],
      ".controller": ["_Game/Art/Animations"],
      ".cs": ["_Game/Config/Input", "_Game/Scripts"],
      ".fbx": ["_Game/Art/Models"],
      ".gif": ["_Game/Art/Animations", "_Game/Art/Sprites"],
      ".inputactions": ["_Game/Config/Input"],
      ".jpg": ["_Game/Art/Sprites", "_Game/Art/Textures"],
      ".json": ["_Game/Config"],
      ".mat": ["_Game/Art/Materials"],
      ".mixer": ["_Game/Audio"],
      ".mp3": ["_Game/Audio/Music", "_Game/Audio/SFX"],
      ".otf": ["_Game/Art/Fonts"],
      ".png": ["_Game/Art/Animations", "_Game/Art/Sprites", "_Game/Art/Textures"],
      ".prefab": ["_Game/Prefabs"],
      ".psd": ["_Game/Art/Sprites", "_Game/Art/Textures"],
      ".shadergraph": ["_Game/Art/Shaders"],
      ".ttf": ["_Game/Art/Fonts"],
      ".unity": ["_Game/Scenes"],
      ".wav": ["_Game/Audio/SFX"]
    }
  ],
  "AllowAllExtensions": [
    "_Game/Resources",
    "Plugins",
    "StreamingAssets",
    "StreamingLanguageModels",
    "TheraBytes",
    "ThirdParty"
  ]
}
